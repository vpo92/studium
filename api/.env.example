# Copier ce fichier vers api/.env et renseigner les identifiants.

# Connexion MongoDB (requise pour l'API, le worker et les jobs backup/restore).
# En Docker, la variable est fournie par docker-compose.
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/studium
# Base de test utilisée par `npm test` (optionnel).
# MONGODB_TEST_CONNECTION_STRING=mongodb://localhost:27017/studium-test
# Nom de la base pour l'import du graphe (optionnel, sinon déduit de l'URL).
# MONGODB_DATABASE=studium

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Active (true) ou désactive (false) les endpoints et l'onglet de graphe.
FEAT_GRAPH=false
